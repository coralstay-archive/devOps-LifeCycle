# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# modules/scenarios aren't standalone deployments (only live/* is) — no
# provider lock file to commit at that scope
modules/*/.terraform.lock.hcl
scenarios/*/.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Secrets / env
.env
.env.*
*.pem
*.key

# OS / editor
.DS_Store
.idea/
.vscode/

# Infracost
infracost.json

# k6
tools/loadtest/*.json

# TLA+ tooling (downloaded, not vendored — see specs/README.md)
.tla-tools/
*.tla.out
states/
